{
  "Equation (numbered)": {
    "scope": "latex",
    "prefix": "eq",
    "body": [
      "\\begin{equation}",
      "  ${1:E = mc^2}",
      "  \\label{eq:${2:name}}",
      "\\end{equation}",
      "$0"
    ],
    "description": "Numbered equation with label (amsmath not required)"
  },
  "Equation (unnumbered)": {
    "scope": "latex",
    "prefix": "eqs",
    "body": [
      "\\begin{equation*}",
      "  ${1:E = mc^2}",
      "\\end{equation*}",
      "$0"
    ],
    "description": "Unnumbered display equation (requires amsmath)"
  },
  "Align (numbered)": {
    "scope": "latex",
    "prefix": "align",
    "body": [
      "\\begin{align}",
      "  ${1:f(x)} &= ${2:a + b} \\label{eq:${3:name}} \\\\\\\\",
      "  ${4:g(x)} &= ${5:c + d} \\nonumber",
      "\\end{align}",
      "$0"
    ],
    "description": "Aligned multi-line equations; first line labelled (requires amsmath)"
  },
  "Align (unnumbered)": {
    "scope": "latex",
    "prefix": "aligns",
    "body": [
      "\\begin{align*}",
      "  ${1:f(x)} &= ${2:a + b} \\\\\\\\",
      "  ${3:g(x)} &= ${4:c + d}",
      "\\end{align*}",
      "$0"
    ],
    "description": "Unnumbered aligned equations (requires amsmath)"
  },
  "Figure": {
    "scope": "latex",
    "prefix": "fig",
    "body": [
      "\\begin{figure}[${1:htbp}]",
      "  \\centering",
      "  \\includegraphics[width=${2:0.8}\\textwidth]{${3:example-image}}",
      "  \\caption{${4:Caption}}",
      "  \\label{fig:${5:name}}",
      "\\end{figure}",
      "$0"
    ],
    "description": "Figure with image, caption and label (requires graphicx)"
  },
  "Subfigures": {
    "scope": "latex",
    "prefix": "subfig",
    "body": [
      "\\begin{figure}[${1:htbp}]",
      "  \\centering",
      "  \\begin{subfigure}[b]{0.48\\textwidth}",
      "    \\centering",
      "    \\includegraphics[width=\\textwidth]{${2:example-image-a}}",
      "    \\caption{${3:Left}}",
      "    \\label{fig:${4:name}-a}",
      "  \\end{subfigure}",
      "  \\hfill",
      "  \\begin{subfigure}[b]{0.48\\textwidth}",
      "    \\centering",
      "    \\includegraphics[width=\\textwidth]{${5:example-image-b}}",
      "    \\caption{${6:Right}}",
      "    \\label{fig:${4:name}-b}",
      "  \\end{subfigure}",
      "  \\caption{${7:Overall caption}}",
      "  \\label{fig:${4:name}}",
      "\\end{figure}",
      "$0"
    ],
    "description": "Two side-by-side subfigures (requires graphicx, subcaption)"
  },
  "Table (booktabs)": {
    "scope": "latex",
    "prefix": "tbl",
    "body": [
      "\\begin{table}[${1:htbp}]",
      "  \\centering",
      "  \\caption{${2:Caption}}",
      "  \\label{tab:${3:name}}",
      "  \\begin{tabular}{${4:lcc}}",
      "    \\toprule",
      "    ${5:Header 1} & ${6:Header 2} & ${7:Header 3} \\\\\\\\",
      "    \\midrule",
      "    ${8:a} & ${9:b} & ${10:c} \\\\\\\\",
      "    \\bottomrule",
      "  \\end{tabular}",
      "\\end{table}",
      "$0"
    ],
    "description": "Table with caption above and booktabs rules (requires booktabs)"
  },
  "Chapter": {
    "scope": "latex",
    "prefix": "chap",
    "body": [
      "\\chapter{${1:Chapter title}}",
      "\\label{chap:${2:name}}",
      "",
      "$0"
    ],
    "description": "Chapter with label (report/book classes only)"
  },
  "Section": {
    "scope": "latex",
    "prefix": "sec",
    "body": [
      "\\section{${1:Section title}}",
      "\\label{sec:${2:name}}",
      "",
      "$0"
    ],
    "description": "Section with label"
  },
  "Subsection": {
    "scope": "latex",
    "prefix": "ssec",
    "body": [
      "\\subsection{${1:Subsection title}}",
      "\\label{sec:${2:name}}",
      "",
      "$0"
    ],
    "description": "Subsection with label"
  },
  "Subsubsection": {
    "scope": "latex",
    "prefix": "sssec",
    "body": [
      "\\subsubsection{${1:Subsubsection title}}",
      "\\label{sec:${2:name}}",
      "",
      "$0"
    ],
    "description": "Subsubsection with label"
  },
  "Citation": {
    "scope": "latex",
    "prefix": "cite",
    "body": [
      "\\\\${1|cite,parencite,textcite,autocite,citeauthor,citeyear|}{${2:key}}$0"
    ],
    "description": "Citation; parencite/textcite/autocite/citeauthor/citeyear require biblatex"
  },
  "Cross-reference": {
    "scope": "latex",
    "prefix": "ref",
    "body": [
      "\\\\${1|ref,eqref,pageref,autoref,cref,Cref|}{${2:sec:name}}$0"
    ],
    "description": "Cross-reference; eqref needs amsmath, autoref hyperref, cref/Cref cleveref"
  },
  "Itemize": {
    "scope": "latex",
    "prefix": "item",
    "body": [
      "\\begin{itemize}",
      "  \\item ${1:First item}",
      "  \\item ${2:Second item}$0",
      "\\end{itemize}"
    ],
    "description": "Bulleted list"
  },
  "Enumerate": {
    "scope": "latex",
    "prefix": "enum",
    "body": [
      "\\begin{enumerate}",
      "  \\item ${1:First item}",
      "  \\item ${2:Second item}$0",
      "\\end{enumerate}"
    ],
    "description": "Numbered list"
  },
  "Description": {
    "scope": "latex",
    "prefix": "desc",
    "body": [
      "\\begin{description}",
      "  \\item[${1:Term}] ${2:Definition}$0",
      "\\end{description}"
    ],
    "description": "Description list"
  },
  "Algorithm": {
    "scope": "latex",
    "prefix": "algo",
    "body": [
      "\\begin{algorithm}[${1:htbp}]",
      "  \\caption{${2:Algorithm name}}",
      "  \\label{alg:${3:name}}",
      "  \\begin{algorithmic}[1]",
      "    \\Require ${4:input}",
      "    \\Ensure ${5:output}",
      "    \\State ${6:\\$x \\gets 0\\$}",
      "    \\For{${7:\\$i \\gets 1\\$ \\textbf{to\\} \\$n\\$}}",
      "      \\State ${8:\\$x \\gets x + i\\$}",
      "    \\EndFor",
      "    \\State \\Return ${9:\\$x\\$}",
      "  \\end{algorithmic}",
      "\\end{algorithm}",
      "$0"
    ],
    "description": "Pseudo-code (requires algorithm + algpseudocode packages)"
  },
  "Code listing": {
    "scope": "latex",
    "prefix": "lst",
    "body": [
      "\\begin{lstlisting}[language=${1|Python,C,C++,bash,Java,Matlab|}, caption={${2:Caption}}, label={lst:${3:name}}]",
      "${4:print(\"hello\")}",
      "\\end{lstlisting}",
      "$0"
    ],
    "description": "Code listing (requires listings)"
  },
  "Theorem": {
    "scope": "latex",
    "prefix": "thm",
    "body": [
      "\\begin{theorem}[${1:Name}]",
      "  \\label{thm:${2:name}}",
      "  ${3:Statement.}",
      "\\end{theorem}",
      "$0"
    ],
    "description": "Theorem (requires \\newtheorem{theorem}{Theorem} in the preamble, e.g. with amsthm)"
  },
  "Lemma": {
    "scope": "latex",
    "prefix": "lem",
    "body": [
      "\\begin{lemma}[${1:Name}]",
      "  \\label{lem:${2:name}}",
      "  ${3:Statement.}",
      "\\end{lemma}",
      "$0"
    ],
    "description": "Lemma (requires \\newtheorem{lemma}{Lemma} in the preamble)"
  },
  "Proof": {
    "scope": "latex",
    "prefix": "proof",
    "body": [
      "\\begin{proof}",
      "  ${1:Proof text.}",
      "\\end{proof}",
      "$0"
    ],
    "description": "Proof environment (requires amsthm)"
  },
  "Matrix": {
    "scope": "latex",
    "prefix": "mat",
    "body": [
      "\\begin{${1|pmatrix,bmatrix,vmatrix,matrix|}}",
      "  ${2:a} & ${3:b} \\\\\\\\",
      "  ${4:c} & ${5:d}",
      "\\end{$1}$0"
    ],
    "description": "Matrix inside math mode (requires amsmath)"
  },
  "Cases": {
    "scope": "latex",
    "prefix": "cases",
    "body": [
      "\\begin{cases}",
      "  ${1:1} & \\text{if } ${2:x > 0} \\\\\\\\",
      "  ${3:0} & \\text{otherwise}",
      "\\end{cases}$0"
    ],
    "description": "Piecewise definition inside math mode (requires amsmath)"
  },
  "Generic environment": {
    "scope": "latex",
    "prefix": "beg",
    "body": [
      "\\begin{${1:environment}}",
      "  $0",
      "\\end{$1}"
    ],
    "description": "Generic \\begin ... \\end pair; the name is mirrored"
  }
}
